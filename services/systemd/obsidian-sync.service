[Unit]
Description=Obsidian headless Sync (vault recorder peer)
After=network-online.target
Wants=network-online.target

[Service]
User=obsidian
# The official obsidian-headless CLI (`ob`, github.com/obsidianmd/obsidian-headless);
# `ob login` + `ob sync-setup` are done once as the obsidian user during
# vault-recorder-setup, then this runs the continuous watcher.
ExecStart=/usr/local/bin/ob sync --path /srv/arnievault --continuous
Restart=on-failure
RestartSec=30
Environment=VAULT_PATH=/srv/arnievault

[Install]
WantedBy=multi-user.target
